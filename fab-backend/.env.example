# Render/Railway usually injects PORT automatically.
PORT=3000
HOST=0.0.0.0

# Comma-separated browser origins allowed to call REST/SSE/WebSocket endpoints.
# For GitHub Pages, use only the origin, not the repo path.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-github-username.github.io
