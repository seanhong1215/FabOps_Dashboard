{
  "name": "fab-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:pages": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:GITHUB_PAGES='true'; npm run build; New-Item -ItemType File -Path 'dist/.nojekyll' -Force\"",
    "deploy": "npm run build:pages && gh-pages -d dist -m \"deploy: update GitHub Pages\"",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vicons/tabler": "^0.13.0",
    "@vueuse/core": "^10.9.0",
    "echarts": "^5.5.0",
    "naive-ui": "^2.38.2",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-echarts": "^6.7.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "gh-pages": "^6.3.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.14",
    "vue-tsc": "^2.0.14"
  }
}
